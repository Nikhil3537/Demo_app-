<p style="color: green"><%= notice %></p>

<% content_for :title, "Tasks" %>

<h1>Tasks</h1>

<div id="tasks">
  <% @tasks.each do |task| %>
    <%= render task %>
    <p>
      <%= link_to "Show this task", task %>
    </p>
  <% end %>
</div>

<%= link_to "New task", new_task_path %>
<%= form_with url: tasks_path, method: :get do |form| %>
  <%= form.label :priority, "Filter by priority" %>
  <%= form.number_field :priority, value: params[:priority] %>
  <%= form.submit "Filter" %>
<% end %>